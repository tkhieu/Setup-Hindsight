#!/usr/bin/env bash
set -euo pipefail
umask 077

plugin_dir=$(dirname "$(dirname "$(readlink -f "$0")")")
skill_dir=$plugin_dir/skills/setup-hindsight-client
env_file=$HOME/.config/hindsight/client.env
official_config=$HOME/.hindsight/coding-agent.json
package=@vectorize-io/hindsight-coding-agents@0.8.2
mode=install

usage() {
    printf 'Usage: %s [install|--status|--uninstall|--dry-run]\n' "$0"
}

case "${1-}" in
    ''|install) ;;
    --status|status) mode=status ;;
    --uninstall|uninstall) mode=uninstall ;;
    --dry-run) mode=dry-run ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
esac
[ "$#" -le 1 ] || { usage >&2; exit 2; }

if [ "$mode" = uninstall ]; then
    if ! command -v npx >/dev/null 2>&1; then
        printf 'Thiếu npx; chưa thể gỡ tích hợp chính thức.\n' >&2
        exit 1
    fi
    if ! npx --yes "$package" uninstall claude-code codex >/dev/null 2>&1; then
        printf 'Gỡ tích hợp chính thức thất bại; kiểm tra npx và thử lại.\n' >&2
        exit 1
    fi
    python3 - "$HOME/.codex/config.toml" <<'PY'
import os, sys, tempfile
path = sys.argv[1]
if os.path.exists(path):
    with open(path, encoding='utf-8') as f:
        text = f.read()
    new = ''.join(line for line in text.splitlines(keepends=True)
                  if line.rstrip('\r\n') != 'hooks = true # hindsight-client-setup')
    if new != text:
        fd, tmp = tempfile.mkstemp(prefix='.config-', dir=os.path.dirname(path))
        try:
            with os.fdopen(fd, 'w', encoding='utf-8') as f:
                f.write(new)
            os.replace(tmp, path)
        finally:
            if os.path.exists(tmp):
                os.unlink(tmp)
PY
    if [ "${HINDSIGHT_CLIENT_PLUGIN_MODE-}" != 1 ]; then
        for target in "$HOME/.claude/skills/setup-hindsight-client" "$HOME/.codex/skills/setup-hindsight-client"; do
            if [ -L "$target" ] && [ "$(readlink -f "$target")" = "$skill_dir" ]; then
                rm "$target"
            fi
        done
    fi
    printf 'Đã gỡ tích hợp và skill. Giữ cấu hình cùng khóa để có thể cài lại.\n'
    exit 0
fi

env_url=${HINDSIGHT_URL-}
env_key=${HINDSIGHT_API_KEY-}
env_bank=${HINDSIGHT_BANK-}
if [ -f "$env_file" ]; then
    if [ "$mode" = install ]; then
        chmod 600 "$env_file"
    fi
    # shellcheck source=/dev/null
    source "$env_file"
elif [ "$mode" = install ]; then
    mkdir -p "$(dirname "$env_file")"
    cp "$plugin_dir/client.env.example" "$env_file"
    chmod 600 "$env_file"
    printf 'Đã tạo %s từ mẫu; hãy điền HINDSIGHT_API_KEY nếu chưa đặt biến môi trường.\n' "$env_file"
fi
HINDSIGHT_URL=${env_url:-${HINDSIGHT_URL:-https://hindsight-api.hieutk.dev}}
HINDSIGHT_API_KEY=${env_key:-${HINDSIGHT_API_KEY:-}}
HINDSIGHT_BANK=${env_bank:-${HINDSIGHT_BANK:-user-$(id -un)}}
HINDSIGHT_URL=${HINDSIGHT_URL%/}
export HINDSIGHT_URL HINDSIGHT_API_KEY HINDSIGHT_BANK
export HINDSIGHT_CONFIG=$official_config

if [[ ! "$HINDSIGHT_URL" =~ ^https?://[^[:space:]]+$ ]]; then
    printf 'HINDSIGHT_URL không hợp lệ.\n' >&2
    exit 2
fi
if [[ "$HINDSIGHT_BANK" == *$'\n'* || -z "$HINDSIGHT_BANK" ]]; then
    printf 'HINDSIGHT_BANK không hợp lệ.\n' >&2
    exit 2
fi

if [ "$mode" = dry-run ]; then
    printf 'Sẽ kiểm tra %s/health và API có xác thực.\n' "$HINDSIGHT_URL"
    printf 'Sẽ cài %s cho Claude Code và Codex, bank %s.\n' "$package" "$HINDSIGHT_BANK"
    printf 'Cấu hình: %s; skill: ~/.claude/skills và ~/.codex/skills.\n' "$official_config"
    exit 0
fi

if [ -z "$HINDSIGHT_API_KEY" ]; then
    printf 'Thiếu HINDSIGHT_API_KEY; điền vào %s hoặc đặt biến môi trường.\n' "$env_file" >&2
    exit 2
fi
if [[ "$HINDSIGHT_API_KEY" =~ [[:cntrl:]] ]]; then
    printf 'HINDSIGHT_API_KEY chứa ký tự điều khiển không hợp lệ.\n' >&2
    exit 2
fi

check_http() {
    local label=$1 path=$2 code escaped_key
    local -a curl_args=(-sS -o /dev/null -w '%{http_code}' --connect-timeout 5 --max-time 15 "$HINDSIGHT_URL$path")
    if [ "${3-}" = auth ]; then
        escaped_key=${HINDSIGHT_API_KEY//\\/\\\\}
        escaped_key=${escaped_key//\"/\\\"}
        code=$(printf 'header = "Authorization: Bearer %s"\n' "$escaped_key" |
            curl --config - "${curl_args[@]}" 2>/dev/null) || code=000
    else
        code=$(curl "${curl_args[@]}" 2>/dev/null) || code=000
    fi
    case "$code" in
        200) printf '%s: OK (HTTP 200)\n' "$label" ;;
        401) printf '%s: HTTP 401; kiểm tra API key.\n' "$label" >&2; return 1 ;;
        000) printf '%s: không kết nối được; kiểm tra tunnel/DNS.\n' "$label" >&2; return 1 ;;
        *) printf '%s: HTTP %s; kiểm tra máy chủ.\n' "$label" "$code" >&2; return 1 ;;
    esac
}

check_http 'Sức khỏe' /health
check_http 'Xác thực' /v1/default/banks auth

configured() {
    [ -f "$official_config" ] && [ -f "$HOME/.claude/settings.json" ] &&
        [ -f "$HOME/.codex/hooks.json" ] && [ -f "$HOME/.codex/config.toml" ] &&
        command -v claude >/dev/null 2>&1 &&
        claude mcp get hindsight >/dev/null 2>&1 &&
        grep -Fq '[mcp_servers.hindsight]' "$HOME/.codex/config.toml" &&
        python3 - "$official_config" <<'PY'
import json, os, sys
try:
    with open(sys.argv[1], encoding='utf-8') as f:
        cfg = json.load(f)
    ok = (cfg.get('serverMode') == 'self-hosted' and
          cfg.get('apiUrl') == os.environ['HINDSIGHT_URL'] and
          cfg.get('apiToken') == os.environ['HINDSIGHT_API_KEY'] and
          cfg.get('bankId') == os.environ['HINDSIGHT_BANK'] and
          cfg.get('autoUpdate') is False)
except (OSError, ValueError):
    ok = False
sys.exit(0 if ok else 1)
PY
}

warn_codex_hooks() {
    if ! python3 - "$HOME/.codex/config.toml" <<'PY'
import sys, tomllib
try:
    with open(sys.argv[1], 'rb') as f:
        features = tomllib.load(f).get('features', {})
    enabled = isinstance(features, dict) and (features.get('hooks') is True or features.get('codex_hooks') is True)
except (OSError, ValueError):
    enabled = False
sys.exit(0 if enabled else 1)
PY
    then
        printf 'Codex hooks chưa bật: thêm [features] và hooks = true vào ~/.codex/config.toml, rồi mở phiên Codex mới.\n' >&2
    fi
}

if [ "$mode" = status ]; then
    if configured; then
        warn_codex_hooks
        printf 'Tích hợp Claude Code và Codex: đã cấu hình; bank %s.\n' "$HINDSIGHT_BANK"
    else
        printf 'Tích hợp chưa đầy đủ; chạy lệnh install.\n' >&2
        exit 1
    fi
    exit 0
fi

if [ "${HINDSIGHT_CLIENT_PLUGIN_MODE-}" != 1 ]; then
    for target in "$HOME/.claude/skills/setup-hindsight-client" "$HOME/.codex/skills/setup-hindsight-client"; do
        if [ -e "$target" ] && { [ ! -L "$target" ] || [ "$(readlink -f "$target")" != "$skill_dir" ]; }; then
            printf 'Đường dẫn skill đã tồn tại và không thuộc installer: %s\n' "$target" >&2
            exit 1
        fi
    done
fi

if ! configured; then
    command -v npx >/dev/null 2>&1 || { printf 'Thiếu npx (Node.js/npm).\n' >&2; exit 1; }
    mkdir -p "$(dirname "$official_config")"
    python3 - "$HOME/.codex/config.toml" <<'PY'
import os, re, shutil, sys, tempfile, tomllib
path = sys.argv[1]
if os.path.exists(path):
    with open(path, 'rb') as f:
        original = f.read()
    try:
        cfg = tomllib.loads(original.decode('utf-8'))
    except (ValueError, UnicodeDecodeError) as exc:
        raise SystemExit(f'Cấu hình Codex không hợp lệ: {exc}')
    features = cfg.get('features', {})
    if not isinstance(features, dict):
        raise SystemExit('Bảng [features] của Codex không hợp lệ.')
    if features.get('hooks') is False or features.get('codex_hooks') is False:
        raise SystemExit('Codex hooks đang bị tắt rõ ràng; hãy bật trong config.toml rồi thử lại.')
    if not (features.get('hooks') or features.get('codex_hooks')) and 'features' in cfg:
        text = original.decode('utf-8')
        match = re.search(r'^\[features\][ \t]*(?:#.*)?$', text, re.M)
        if not match:
            raise SystemExit('Không thể sửa an toàn bảng [features] của Codex.')
        new = text[:match.end()] + '\nhooks = true # hindsight-client-setup' + text[match.end():]
        shutil.copy2(path, path + '.hindsight-client-backup')
        os.chmod(path + '.hindsight-client-backup', 0o600)
        fd, tmp = tempfile.mkstemp(prefix='.config-', dir=os.path.dirname(path))
        try:
            with os.fdopen(fd, 'w', encoding='utf-8') as f:
                f.write(new)
            os.replace(tmp, path)
        finally:
            if os.path.exists(tmp):
                os.unlink(tmp)
PY
    python3 - "$official_config" <<'PY'
import json, os, shutil, sys, tempfile
path = sys.argv[1]
try:
    with open(path, encoding='utf-8') as f:
        cfg = json.load(f)
except FileNotFoundError:
    cfg = {}
if not isinstance(cfg, dict):
    raise SystemExit('Cấu hình Hindsight phải là JSON object.')
cfg.update(serverMode='self-hosted', apiUrl=os.environ['HINDSIGHT_URL'],
           apiToken=os.environ['HINDSIGHT_API_KEY'], bankId=os.environ['HINDSIGHT_BANK'],
           autoUpdate=False)
if os.path.exists(path):
    shutil.copy2(path, path + '.hindsight-client-backup')
    os.chmod(path + '.hindsight-client-backup', 0o600)
fd, tmp = tempfile.mkstemp(prefix='.coding-agent-', dir=os.path.dirname(path))
try:
    with os.fdopen(fd, 'w', encoding='utf-8') as f:
        json.dump(cfg, f, indent=2, ensure_ascii=False)
        f.write('\n')
    os.replace(tmp, path)
finally:
    if os.path.exists(tmp):
        os.unlink(tmp)
PY
    output=$(mktemp)
    trap 'rm -f "$output"' EXIT
    if ! npx --yes "$package" install claude-code codex --server self-hosted --api-url "$HINDSIGHT_URL" >"$output" 2>&1; then
        printf 'Cài tích hợp chính thức thất bại. Kiểm tra npx, Claude Code, Codex; xem hướng dẫn trong README.\n' >&2
        exit 1
    fi
    rm -f "$output"
    trap - EXIT
fi
if ! configured; then
    printf 'Tích hợp chưa đầy đủ sau khi cài; kiểm tra Claude Code/Codex và thử lại.\n' >&2
    exit 1
fi
warn_codex_hooks

if [ "${HINDSIGHT_CLIENT_PLUGIN_MODE-}" != 1 ]; then
    for target in "$HOME/.claude/skills/setup-hindsight-client" "$HOME/.codex/skills/setup-hindsight-client"; do
        mkdir -p "$(dirname "$target")"
        if [ ! -L "$target" ]; then
            ln -s "$skill_dir" "$target"
        fi
    done
fi
printf 'Đã cài Hindsight cho Claude Code và Codex; bank %s.\n' "$HINDSIGHT_BANK"
