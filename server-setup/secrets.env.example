# Template. bin/bootstrap.sh copies this to secrets.env and fills in what it
# can generate itself (HINDSIGHT_DB_PASSWORD, HINDSIGHT_API_TENANT_API_KEY,
# HINDSIGHT_CP_ACCESS_KEY via `openssl rand -hex 32`). The rest you fill by
# hand. NEVER commit the real secrets.env (already gitignored).
#
# ⚠️  BACKUP secrets.env RA NGOÀI SERVER (password manager / máy khác).
#   - Mất HINDSIGHT_API_TENANT_API_KEY / HINDSIGHT_CP_ACCESS_KEY = phải cấp
#     lại key cho mọi agent/MCP client và người dùng UI.
#   - Mất HINDSIGHT_DB_PASSWORD trong khi Postgres còn sống thì chịu, nhưng
#     mất luôn container/volume thì mất cả Postgres.

# Postgres password for the hindsight_user role (db service in compose.yaml).
HINDSIGHT_DB_PASSWORD=

# OpenAI API key used for retain/recall/reflect LLM calls
# (HINDSIGHT_API_LLM_API_KEY — confirmed in hindsight_api/config.py).
HINDSIGHT_API_LLM_API_KEY=

# Hindsight's own API key (HINDSIGHT_API_TENANT_API_KEY, consumed by
# ApiKeyTenantExtension — confirmed in
# hindsight_api/extensions/builtin/tenant.py). Required by every HTTP/MCP
# client as `Authorization: Bearer <key>`; also fed to the UI container as
# HINDSIGHT_CP_DATAPLANE_API_KEY (compose.yaml) so the control plane can
# call its own API.
HINDSIGHT_API_TENANT_API_KEY=

# UI (control plane) login password — HINDSIGHT_CP_ACCESS_KEY, confirmed in
# hindsight-control-plane/src/app/api/auth/login/route.ts. Separate from the
# API key above; this gates the browser UI's own login screen. Put
# Cloudflare Access in front too (docs/PLAYBOOK.md §2) — this key alone is
# not meant to be the only thing standing between the UI and the internet.
HINDSIGHT_CP_ACCESS_KEY=

# R2 S3-compatible endpoint for the account, e.g.
# https://<account-id>.r2.cloudflarestorage.com
RCLONE_CONFIG_R2_ENDPOINT=

# R2 API token scoped to R2_BUCKET (see base.env) — Object Read & Write is
# enough; it does not need admin/account-level access.
RCLONE_CONFIG_R2_ACCESS_KEY_ID=
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=

# Path to the Cloudflare Tunnel credentials JSON for the hindsight tunnel
# (see cloudflared/config.yml's credentials-file). Not read by compose or
# any script here — recorded for backup awareness only (docs/PLAYBOOK.md
# §10): it lives outside this repo and is not covered by bin/backup-r2.sh.
CLOUDFLARED_CREDENTIALS_FILE=
