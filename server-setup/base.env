# Non-secret config — safe to commit. Secrets live in secrets.env (see
# secrets.env.example; never committed, see .gitignore).
#
# Literal values only, no ${VAR} interpolation: Compose v2 --env-file
# chaining does not reliably expand references *across* env files (it does
# reliably expand ${VAR} inside compose.yaml itself from the merged set of
# --env-file values — that's how bin/hs wires base.env/version.env/
# secrets.env into compose.yaml).

# ---- Database ----
# Matches the official external-pg compose example's defaults
# (HINDSIGHT_DB_USER/HINDSIGHT_DB_NAME). Password lives in secrets.env.
HINDSIGHT_DB_USER=hindsight_user
HINDSIGHT_DB_NAME=hindsight_db

# ---- LLM provider ----
# Confirmed in hindsight_api/config.py: HINDSIGHT_API_LLM_PROVIDER, default
# already "openai" — set explicitly so this stays true even if upstream
# changes its default. The key itself is a secret (secrets.env).
HINDSIGHT_API_LLM_PROVIDER=openai

# Embeddings/reranker provider is intentionally left at the Hindsight
# default ("local": bge-small-en-v1.5 + ms-marco-MiniLM-L-6-v2, baked into
# the image and persisted via the hf_cache volume — see compose.yaml). Only
# the retain/recall/reflect LLM calls go to OpenAI. Switching embeddings to
# OpenAI too would need HINDSIGHT_API_EMBEDDINGS_PROVIDER=openai here plus
# an OpenAI key with embeddings access; not requested, so left out.

# ---- Topology: localhost-only, Cloudflare Tunnel in front ----
# compose.yaml binds both ports to 127.0.0.1 only; cloudflared (host
# systemd --user service, see cloudflared/) is the only way in from outside.
HINDSIGHT_API_HOST_PORT=8888
HINDSIGHT_CP_HOST_PORT=9999

# ---- Backup ----
# A dump this small is almost certainly empty/truncated, not a real backup.
HINDSIGHT_BACKUP_MIN_BYTES=2048
# Local backups (bin/backup.sh) to keep before pruning older ones.
HINDSIGHT_BACKUP_KEEP=14

# ---- Backup to Cloudflare R2 ----
# rclone reads remote config from RCLONE_CONFIG_<NAME>_<KEY> env vars, so no
# rclone.conf file is needed — credentials (endpoint/keys) live in
# secrets.env instead.
RCLONE_CONFIG=/dev/null
R2_BUCKET=hindsight-hieutk-dev-backups
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
# REQUIRED for a bucket-scoped token: rclone calls CreateBucket by default to
# check the bucket exists before writing, and an Object-level-scoped token
# lacks that permission — every write would otherwise fail with
# "CreateBucket 403 AccessDenied" (looks like a bad credential, isn't).
RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true
