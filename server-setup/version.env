# Single source of truth for pinned image versions. Editing this file and
# running `bin/upgrade.sh <ver>` (or `bin/hs pull && bin/hs up -d`) is the upgrade.
#
# Verified against the v1.1.0 tag source and the official external-pg
# compose example (docker/docker-compose/external-pg/docker-compose.yaml in
# github.com/vectorize-io/hindsight): the published image tag has no leading
# "v" (release.yml strips it from the git tag), so this must read "1.1.0",
# not "v1.1.0".
HINDSIGHT_VERSION=1.2.0
# Standalone slim variant (API + control plane, without local ML models).
# Keep the suffix separate so bin/upgrade.sh can still change the version.
HINDSIGHT_IMAGE_SUFFIX=-slim

# Major version of the pgvector/pgvector image (tag: pgvector/pgvector:pg<N>).
# Also controls the PGDATA subpath the image's entrypoint uses
# (/var/lib/postgresql/<N>/docker) — see compose.yaml's db.volumes comment.
# Matches the official compose example's HINDSIGHT_DB_VERSION default.
HINDSIGHT_DB_VERSION=18
