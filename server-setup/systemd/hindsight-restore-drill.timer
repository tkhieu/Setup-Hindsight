[Unit]
Description=Hindsight monthly database restore drill

[Timer]
# Host-local UTC: 03:30 ICT on the 15th. Offset from Omnigent's drill
# (*-*-04 20:30:00 UTC, the 5th) by 10 days so the two monthly drills never
# land on the same day, even with RandomizedDelaySec on both.
OnCalendar=*-*-14 20:30:00
Persistent=true
RandomizedDelaySec=900
Unit=hindsight-restore-drill.service

[Install]
WantedBy=timers.target
