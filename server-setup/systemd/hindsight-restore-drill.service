# Installed by bin/install-systemd.sh, which resolves @CONFIG_DIR@.
[Unit]
Description=Hindsight monthly database restore drill
After=network-online.target docker.service
Wants=network-online.target
OnFailure=ops-notify@%N.service
OnSuccess=ops-notify@%N.service

[Service]
Type=oneshot
ExecStart=@CONFIG_DIR@/bin/restore-db.sh --drill r2:latest
TimeoutStartSec=3600
